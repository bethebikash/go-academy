# Application Environment
APP_ENV=development
APP_PORT=8080
APP_NAME="Go Academy"

# Logging (debug, info, warn, error)
LOG_LEVEL=debug

# Frontend URL (for CORS and invitation links)
FRONTEND_URL=http://localhost:5173

# Database Connection (PostgreSQL)
DATABASE_URL=postgres://goacademy:goacademy_password@localhost:5432/goacademy_dev?sslmode=disable
DB_MAX_OPEN_CONNS=25
DB_MAX_IDLE_CONNS=5
DB_MAX_IDLE_TIME=15m

# JWT & Authentication
# JWT Secret should be at least 32 characters long
JWT_SECRET=development_jwt_secret_change_in_production_min_32_bytes!
JWT_ACCESS_EXPIRY=15m
REFRESH_TOKEN_EXPIRY=7d

# Cookie Security (false in development, true in production)
COOKIE_SECURE=false
COOKIE_DOMAIN=localhost

# Rate Limiting (requests per minute)
RATE_LIMIT_LOGIN=5
RATE_LIMIT_REGISTER=5
